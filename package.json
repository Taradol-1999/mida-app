    "db:import-official": "tsx --env-file=.env.local scripts/import-official-projects.mjs",
    "db:create-admin": "tsx --env-file=.env.local scripts/create-admin.mjs",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
