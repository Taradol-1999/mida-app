    "dotenv": "^18.0.3",
    "jose": "^6.0.8",
    "leaflet": "^1.9.4",
    "mariadb": "^3.5.4",
    "next": "^16.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.18.12",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.0.1",
    "prettier": "^3.9.8",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
