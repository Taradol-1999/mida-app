# Copy this file to .env.production on the deployment server.
# Never commit .env.production.
APP_PORT=3000

DB_HOST=db
DB_PORT=3306
DB_NAME=mida_app
DB_USER=mida_app
DB_PASSWORD=replace_with_a_strong_database_password
DB_ROOT_PASSWORD=replace_with_a_different_root_password
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_characters
UPLOADS_DIRECTORY=/app/uploads

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-JDL7VL37WJ

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Mida Property

MIDA_LINE_URL=
MIDA_MESSENGER_URL=
