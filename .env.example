# MySQL connection used by the Next.js server. Do not commit .env.local.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mida_app
DB_USER=root
DB_PASSWORD=replace_with_your_password
# Required only for a remote MySQL 8 server using caching_sha2_password.
# It is enabled automatically for localhost / 127.0.0.1.
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false

# Use a long, random value in production (at least 32 characters).
AUTH_SECRET=replace_with_a_long_random_secret

# Absolute local directory for uploaded MIDA images and videos.
UPLOADS_DIRECTORY=/Users/your-name/uploads/mida
